# ================================================
# AETERIUM ECOM DROP — Variables de Entorno
# ================================================
# BACKEND (Railway) — añade estas en el panel de
# tu servicio: Settings > Variables
# ================================================

# API Key de Dropea (GraphQL)
DROPEA_API_KEY=tu_dropea_api_key_aqui

# API Key de Google Gemini
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Puerto — Railway lo inyecta automáticamente, no tocar
# PORT=3000

# ================================================
# FRONTEND (Vercel) — añade en Project Settings >
# Environment Variables
# ================================================

# URL del backend en Railway (sin barra final)
# Ej: VITE_API_URL=https://aeterium-backend.up.railway.app
VITE_API_URL=
